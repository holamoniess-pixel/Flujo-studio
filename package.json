{
  "name": "content-creator",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first adaptive multimodal creative operating system",
  "author": "Flujo Studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:frontend": "vitest run",
    "test:electron": "node --test electron/*.test.cjs",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "npm run build && electron .",
    "backend:dev": "py backend/run.py",
    "backend:build": "py -m PyInstaller --noconfirm --clean backend\\flujo-engine.spec --distpath backend\\dist --workpath backend\\build",
    "desktop:build": "npm run build && npm run backend:build && electron-builder --win portable"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "studio.flujo.desktop",
    "productName": "Flujo Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/dist/FlujoEngine.exe",
      "resources/media/**/*",
      "resources/executor/**/*",
      "resources/third-party/**/*",
      "FFMPEG_NOTICES.md",
      "THIRD_PARTY_LICENSES/**/*"
    ],
    "asarUnpack": [
      "backend/dist/FlujoEngine.exe",
      "resources/media/**/*",
      "resources/executor/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
